{
  "name": "agent-digitama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sprites:fetch": "node scripts/fetch-sprites.ts",
    "sprites:build": "node scripts/build-sprites.ts && node scripts/build-up-sprites.ts && oxfmt --write src/sprites.generated.ts src/up-sprites.generated.ts src/up-images.generated.ts src/up-images",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.json",
    "lint": "oxlint src scripts tests hooks",
    "format": "oxfmt --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "csv-parse": "7.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.87.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
