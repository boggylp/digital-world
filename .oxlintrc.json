{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["plugins/*/hooks/**"],
      "rules": {
        "unicorn/no-array-fill-with-reference-type": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/*.generated.js",
    "**/*.generated/**",
    "**/hooks/make-colors.js"
  ]
}
